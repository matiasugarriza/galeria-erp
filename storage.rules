rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// Propuesta de reglas de seguridad para el bucket de la Galería de Imágenes
// (decisión resuelta del 2026-10-26 — plan.md, decisión abierta 1).
//
// ⚠️ ARCHIVO PROPUESTO: revisa y ajusta las condiciones de autenticación al
//    modelo de sesión real de tu ERP antes de desplegar.
//
// Despliegue: firebase deploy --only storage
//             (o pegando el contenido en Consola de Firebase → Storage → Reglas)
//
// Notas:
// - El pipeline del servidor (Cloud Function con Admin SDK) bypasea estas
//   reglas: el procesamiento en backend no depende de los permisos de cliente.
// - La validación de tamaño (10 MB) en cliente y aquí es una doble defensa;
//   el techo definitivo de 300 KB lo garantiza el pipeline de la feature 006.
// ═══════════════════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {

    // Lectura: solo usuarios autenticados (la galería y el plugin ERP operan
    // con sesión iniciada; getDownloadURL funciona bajo esta regla).
    match /{allPaths=**} {
      allow read: if request.auth != null;
    }

    // Escritura de imágenes nuevas (subidas desde el complemento):
    // - usuario autenticado
    // - tipo MIME de imagen admitido por el pipeline (feature 006: la salida
    //   final es siempre image/jpeg, pero la entrada acepta los formatos
    //   soportados que la Cloud Function convierte)
    // - tamaño máximo 10 MB (validación duplicada con el cliente)
    // - dentro de una carpeta de contexto de primer nivel (ej. productos/,
    //   facturas/, avatares/) — refuerza la convención {carpeta}/{código}[_N].jpg
    match /{carpeta}/{archivo} {
      allow create, update: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif|tiff|gif|bmp)')
        && !carpeta.matches('\\.?.*'); // sin carpetas ocultas ni vacías

      // Borrado: usuario autenticado (feature 005; la confirmación en el
      // modal de diálogo es responsabilidad del componente).
      // En delete no existe request.resource, por eso se separa de create/update.
      allow delete: if request.auth != null;
    }
  }
}
