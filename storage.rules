rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// Reglas de seguridad del bucket de la Galería de Imágenes
//
// Decisión del 2026-11-04 (demo): acceso PÚBLICO — lectura libre y
// escritura/borrado libres con validación de MIME y tamaño, para que la
// demo funcione sin sesión (la app no usa firebase/auth). Responde a la
// incidencia storage/unauthorized que dejaba la galería sin imágenes.
//
// ⚠️ ANTES DE PRODUCCIÓN: reintroducir `request.auth != null` (u otro modelo
//    de sesión) según el modelo real del ERP — decisión abierta 1 de
//    plan.md (2026-10-26).
//
// Despliegue: firebase deploy --only storage
//             (o pegando el contenido en Consola de Firebase → Storage → Reglas)
//
// Notas:
// - El pipeline del servidor (Cloud Function con Admin SDK) bypasea estas
//   reglas: el procesamiento en backend no depende de los permisos de cliente.
// - La validación de tamaño (10 MB) en cliente y aquí es una doble defensa;
//   el techo definitivo de 300 KB lo garantiza el pipeline de la feature 006.
// - En delete no existe request.resource, por eso create/update y delete
//   van en reglas separadas.
// ═══════════════════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {

      // Lectura pública: la galería (modo standalone y modo ERP) lista y
      // genera URLs de descarga sin sesión.
      allow read: if true;

      // Escritura pública validada: solo imágenes, máximo 10 MB.
      // Cubre raíz (subidas del modo standalone) y carpetas de contexto
      // (ej. migradas/, productos/) — convención {carpeta}/{archivo}[_N].jpg.
      allow create, update: if request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif|tiff|gif|bmp)');

      // Borrado público (feature 005; la confirmación en el modal de
      // diálogo es responsabilidad del componente).
      allow delete: if true;
    }
  }
}
